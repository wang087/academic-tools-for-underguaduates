{
  "_comment": "学部官网数据源配置 —— 阶段 S 的**唯一**导师数据来源。",
  "_why_this_file": [
    "学校教师主页系统（如 faculty.ustc.edu.cn / person.zju.edu.cn）有两个硬伤：",
    "  ① 它只登记『已在系统里维护主页』的教师，覆盖面不全；",
    "  ② 大量页面根本没有『研究方向』栏位（实测 USTC 237 人中 130 人没有）。",
    "学部/学院官网的师资页是**学院自己维护**的，方向/邮箱/职称通常直接写在列表页上，",
    "新鲜度与完整度都更好。因此本流程**统一以学部官网为准**，不再使用学校教师主页系统。",
    "",
    "本文件按『学校 → 学部/学院 → 师资栏目』三级组织。",
    "新增学校时只需在 universities 下加一个条目，**不需要改脚本**。"
  ],
  "version": "1.0",
  "updated": "2026-10-02",

  "_schema": {
    "universities.<key>.name": "学校全称，用于报告标题",
    "universities.<key>.alias": "简称/别名数组，供 --unit 模糊匹配",
    "universities.<key>.units.<key>.name": "学部/学院全称",
    "universities.<key>.units.<key>.base": "站点根 URL（含协议）",
    "universities.<key>.units.<key>.list_type": "列表页模板，见 list_types",
    "universities.<key>.units.<key>.sections": "要抓的师资栏目数组",
    "sections[].name": "栏目中文名（写进报告）",
    "sections[].path": "栏目列表页路径（相对 base）",
    "sections[].paging": "分页规则，见 paging_types；默认 auto 自动探测",
    "sections[].detail": "star=列表页已含方向/邮箱；fetch=需进详情页补",
    "sections[].note": "备注，报告里会原样展示"
  },

  "list_types": {
    "_comment": "不同学校站群系统的列表 HTML 结构不同，这里定义各自的解析规则。",
    "wp_teacher_card": {
      "_desc": "学校 WebPlus 站群：<li class=list-item> 内含 <h3>姓名 职称</h3> + span.direction + span.email",
      "_verified": "浙江大学生命科学学院 www.cls.zju.edu.cn（2026-10-02 实测）",
      "item_re": "<li[^>]*class=\"[^\"]*list-item[^\"]*\"[^>]*>(.*?)</li>",
      "name_re": "<h3>\\s*(.*?)\\s*(?:<span|</h3>)",
      "title_in_name": true,
      "direction_re": "class=\"direction\">(.*?)</span>",
      "email_re": "class=\"email\">(.*?)</span>",
      "link_re": "<a[^>]+href=\"([^\"]+)\"",
      "simple_item_re": "<li[^>]*class=\"[^\"]*list-teachers-item[^\"]*\"[^>]*>\\s*<a[^>]+href=\"([^\"]+)\"[^>]*>(.*?)</a>",
      "pages_re": "页码[^0-9]{0,12}(\\d+)\\s*/\\s*(\\d+)",
      "total_re": "总共[^0-9]{0,12}(\\d+)[^0-9]{0,12}记录",
      "perpage_re": "每页[^0-9]{0,12}(\\d+)[^0-9]{0,12}记录"
    },
    "wp_newsinfo_card": {
      "_desc": "学校 WebPlus 站群变体：列表只给姓名+链接，方向在详情页正文里",
      "_verified": "中国科学技术大学生命科学与医学部 biomed.ustc.edu.cn（2026-10-02 实测）",
      "_markup": "实测 2026-10-04：条目标记为 <li class=\"itemhover clearfix\"><a href=\"/YYYY/MMDD/c<cid>a<aid>/page.htm\">，姓名在 <div class=\"tit\"> 内；本页无 <h3>。分页计数在 <em class=\"all_count\">N</em> / <em class=\"per_count\">M</em>。",
      "item_re": "<li[^>]*class=\"[^\"]*itemhover[^\"]*\"[^>]*>(.*?)</li>",
      "name_re": "<div[^>]*class=\"tit\"[^>]*>(.*?)</div>",
      "title_in_name": false,
      "direction_re": "",
      "email_re": "",
      "link_re": "<a[^>]+href=\"([^\"]+page\\.htm)\"",
      "simple_item_re": "<li[^>]*class=\"[^\"]*itemhover[^\"]*\"[^>]*>\\s*<a[^>]+href=\"([^\"]+page\\.htm)\"[^>]*>(.*?)</a>",
      "_simple_item_re_note": "组1=详情页 href，组2=块内 HTML（parse_list_page 用 split_name_title 抽名）。姓名在块内 <div class=\"tit\">，由 name_re 抽出后经 _clean_name 过滤。",
      "pages_re": "页码[^0-9]{0,80}?(\\d+)\\s*/\\s*(\\d+)",
      "total_re": "总共[^0-9]{0,40}?(\\d+)",
      "perpage_re": "每页[^0-9]{0,40}?(\\d+)"
    }
  },

  "universities": {
    "ustc": {
