      "alias": ["中科大", "中国科大", "ustc", "科大"],
      "units": {
        "life-med": {
          "name": "生命科学与医学部",
          "base": "https://biomed.ustc.edu.cn",
          "list_type": "wp_newsinfo_card",
          "sections": [
            { "name": "生命科学学院", "path": "/smkxy/list.htm",  "paging": "auto", "detail": "fetch" },
            { "name": "基础医学院",   "path": "/jcyxy/list.htm",  "paging": "auto", "detail": "fetch" },
            { "name": "临床医学院",   "path": "/lcyxy/list.htm",  "paging": "auto", "detail": "fetch" },
            { "name": "生物医学工程学院", "path": "/swyxgcxy/list.htm", "paging": "auto", "detail": "fetch" },
            { "name": "附属第一医院", "path": "/swx/list.htm",    "paging": "auto", "detail": "fetch",
              "note": "附属医院师资，方向多在详情页" }
          ]
        }
      }
    },

    "zju": {
      "name": "浙江大学",
      "alias": ["浙大", "zju", "浙江大学"],
      "units": {
        "life-sci": {
          "name": "生命科学学院",
          "base": "http://www.cls.zju.edu.cn",
          "list_type": "wp_teacher_card",
          "sections": [
            { "name": "求是讲席教授", "path": "/clscn/zjdxwqsjxwjs/list.htm", "paging": "auto", "detail": "star" },
            { "name": "求是特聘学者", "path": "/clscn/38604/list.htm", "paging": "auto", "detail": "star" },
            { "name": "百人计划研究员", "path": "/clscn/38609/list.htm", "paging": "auto", "detail": "star" },
            { "name": "生物化学研究所", "path": "/clscn/26369/list.htm", "paging": "auto", "detail": "star" },
            { "name": "细胞与发育生物学研究所", "path": "/clscn/26370/list.htm", "paging": "auto", "detail": "star" },
            { "name": "遗传与再生生物学研究所", "path": "/clscn/26371/list.htm", "paging": "auto", "detail": "star" },
            { "name": "植物生物学研究所", "path": "/clscn/26366/list.htm", "paging": "auto", "detail": "star" },
            { "name": "微生物研究所", "path": "/clscn/26368/list.htm", "paging": "auto", "detail": "star" },
            { "name": "生态研究所", "path": "/clscn/26367/list.htm", "paging": "auto", "detail": "star" },
            { "name": "生物物理研究所", "path": "/clscn/swwlyjs/list.htm", "paging": "auto", "detail": "star" },
            { "name": "兼聘教师", "path": "/clscn/38598/list.htm", "paging": "auto", "detail": "fetch",
              "note": "列表页只有姓名，无方向；如需方向须进详情页" },
            { "name": "支撑队伍", "path": "/clscn/26363/list.htm", "paging": "auto", "detail": "fetch",
              "note": "技术与行政支撑岗，通常无研究方向" }
          ]
        }
      }
    }
  },

  "paging_types": {
    "_comment": "分页 URL 的拼法。auto=先抓 list.htm，再从页尾『页码 x / y』推断，自动翻 list2/list3…；single=只有一页；query=?page=N",
    "auto": { "pattern": "{base}{dir}/list{page}.htm", "first": "{base}{dir}/list.htm" },
    "psp":  { "pattern": "{base}{dir}/list{page}.psp", "first": "{base}{dir}/list.psp" },
    "query": { "pattern": "{base}{dir}/list.htm?page={page}", "first": "{base}{dir}/list.htm" },
    "single": { "pattern": "{base}{dir}/list.htm", "first": "{base}{dir}/list.htm" }
  },

  "parse_rules": {
    "_comment": "与学校无关的通用清洗规则。改判据请同时更新 scripts 里的 _is_direction。",
    "title_keywords": ["高级实验师", "实验师", "高级工程师", "教授级高级工程师",
                       "正高级工程师", "高级讲师", "助理研究员", "助理教授",
                       "特聘副研究员", "特任副研究员", "副研究员", "特聘研究员",
                       "特任教授", "特聘教授", "讲席教授", "客座教授",
                       "百人计划研究员", "青年研究员", "研究员", "副教授",
                       "教授", "讲师", "博士后", "工程师", "院士",
                       "博导", "硕导", "特任", "高级", "副高级"],
    "strip_title_from_name": true,
    "direction_split": "[，,、；;]",
    "email_re": "[\\w.+-]+@[\\w.-]+\\.\\w{2,}",
    "unverified_notice": "归类是关键词粗分类，请以学院官网原文为准"
  }
}
