# ── 流程1 版本控制忽略规则（2026-10-02 建立）───────────────────
#
# 决策：vendor/ **不入库**。
#   理由：它是**拷贝进来的第三方快照**（无 .git），共 88.8 MB，其中 9.1 MB
#   还是生成物（vendor/ppt-master/projects/ 的 pptx 导出）。
#   完整性核验靠 PACKAGE_MANIFEST.json 的逐文件 sha256。
#   若日后要自包含，删掉下面这行再 git add 即可。
vendor/

# ── 运行副产物（流程跑起来才会生成，不应入库）─────────────────
# [STOP] 注释必须**独占一行**。git 只在行首认 `#`；写成
#   `.work_cdp/   # 中间数据`
# 会把整行（含空白与 `#` 之后的文字）当成 pattern，**规则静默失效** ——
#   实测后果：`git add <作者>/` 会真的把 CDP profile、PDF 与 .work_cdp 加进来
#   （首批 dry-run 就列出 .edge-cdp-p9223/Default/… 数百个文件）。
.work_cdp/
*_paper_Exports/
*_Exports/
.edge-cdp-*/
*.log

# ── nature_bridge 临时目录（防线③：万一本脚本的回收逻辑被改坏）──────
# 背景：nature_bridge.py 的 scratch_dir() 用 mkdir() 而非 mkdtemp()（沙箱下
#   0700 目录写不进去），代价是**不会自动删除**。早期版本只 unlink 临时文件、
#   不删目录，且当 gettempdir() 被沙箱解析到工作区内时，就每跑一次 check
#   在 流程1/ 留下 2–3 个空文件夹（实测积了 14 个，跨 4 个 PID）。
#   脚本现已用「调用点 finally: _reclaim()」+「atexit 兜底」两道防线回收；
#   这条 ignore 是第三道，只防回归，不代表可以容忍泄漏。
nature_bridge_*/

# ── 运行产物（按日输出根）───────────────────────────────────
# 单次运行的 raw HTML 存档、PDF、全文 txt 可达 GB 级（实测 20261006/ ≈ 984 MB），
# 且里面是抓取现场，不是本仓库要长期携带的内容 —— 一律不入库。
202*/
outputs/

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/

# ── 编辑器 / 系统 ─────────────────────────────────────────
.DS_Store
Thumbs.db
