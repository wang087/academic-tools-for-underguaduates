#!/usr/bin/env bash
# llm —— 便携 llama.cpp 生命周期入口（Linux / macOS / Git-Bash / WSL）
# =====================================================================
# 不依赖绝对路径：脚本自动定位自身，并把工作区/模型/bin 交给 python 端推断。
# 自动选择可用的解释器；缺依赖时 python 端会自行安装。
#
# 用法：
#   ./llm doctor
#   ./llm serve --model Qwen3-0.6B
#   ./llm status
#   ./llm release --latest
#   ./llm sweep                 # 回收被硬杀后残留的孤儿服务
#   ./llm run --model Qwen3-0.6B -- python my_experiment.py
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ── 选解释器：环境变量 → PATH → 常见 venv（相对本脚本向上找）──
PY="${LLM_PYTHON:-}"
if [ -z "$PY" ]; then
  for c in python3 python; do
    if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
  done
fi
if [ -z "$PY" ]; then
  # 向上找本仓库自带的 venv（Windows venv 在 Scripts/，POSIX 在 bin/）
  d="$SELF_DIR"
  for _ in 1 2 3 4 5; do
    d="$(dirname "$d")"
    for cand in "$d/.venv/bin/python" "$d/.venv/Scripts/python.exe"; do
      if [ -x "$cand" ]; then PY="$cand"; break 2; fi
    done
  done
fi
if [ -z "$PY" ]; then
  echo "[X] 找不到 python 解释器。设 LLM_PYTHON 指定，或装 python3。" >&2
  exit 2
fi

cmd="${1:-}"; shift || true

case "$cmd" in
  serve|status|release|doctor|sweep)
    exec "$PY" "$SELF_DIR/llm_lifecycle.py" "$cmd" "$@"
    ;;
  run)
    exec "$PY" "$SELF_DIR/run_with_llm.py" "$@"
    ;;
  ""|-h|--help|help)
    sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    echo
    echo "解释器: $PY"
    echo "子命令: doctor | serve | status | release | sweep | run"
    ;;
  *)
    echo "[X] 未知子命令: $cmd" >&2
    echo "    可用: doctor | serve | status | release | sweep | run" >&2
    exit 2
    ;;
esac
