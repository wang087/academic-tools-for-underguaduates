{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flow1/interpret-task",
  "title": "流程1作者论文解读任务包",
  "type": "object",
  "required": ["seq", "doi", "title", "interpret_tier", "abstract", "result_path"],
  "properties": {
    "seq": {"type": "integer", "minimum": 1},
    "interpret_tier": {"type": "string"},
    "interpret_engine": {"type": "string"},
    "doi": {"type": "string", "minLength": 3},
    "title": {"type": "string", "minLength": 1},
    "journal": {"type": "string"},
    "year": {"type": ["string", "integer", "null"]},
    "authors": {"type": ["string", "array", "null"]},
    "my_position": {"type": ["string", "null"]},
    "abstract": {"type": "string"},
    "pdf": {"type": ["string", "null"]},
    "pages": {"type": ["integer", "null"], "minimum": 0},
    "evidence_source": {"type": "string"},
    "text_extraction_status": {"type": "string"},
    "text_extraction_backend": {"type": "string"},
    "text_extraction_errors": {"type": "array", "items": {"type": "string"}},
    "text_chars": {"type": "integer", "minimum": 0},
    "text_truncated": {"type": "boolean"},
    "text_omitted_chars": {"type": "integer", "minimum": 0},
    "fulltext_chars": {"type": "integer", "minimum": 0},
    "fulltext_path": {"type": ["string", "null"]},
    "figure_dir": {"type": ["string", "null"]},
    "figures_manifest": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "figure_count": {"type": "integer", "minimum": 0},
    "text": {"type": "string"},
    "tag_vocabulary": {"type": ["object", "null"]},
    "result_path": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
